# Makina configuration for the todo starter project
base_branch = "develop"
concurrency = 2

[caps]
gate_iterations = 5
reviewer_iterations = 3
wall_clock_secs = 1200

[[gates]]
name = "test"
command = "cargo test"

[[gates]]
name = "clippy"
command = "cargo clippy -- -D warnings"

[[gates]]
name = "fmt"
command = "cargo fmt --check"
